<?xml version="1.0" encoding="utf-8"?>
<!-- One manifest row. Flat and fixed-height so a 500-row list scrolls without layout work. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/manifestRow"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/zoneBar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#2E7D6B"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/manifestHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#34434A"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/manifestDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#34434A"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/manifestAssignee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#64747C"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
