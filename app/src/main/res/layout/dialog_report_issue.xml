<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP SECONDARY SHEET HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volunteer_report_issue"
            android:textColor="#64747C"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/secondary_sheet_state"
            android:textColor="#64747C"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#AAB7BC"/>

        <!-- BENEFICIARY SUMMARY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_profile_highlight"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/issueBeneficiaryName"
                    android:text="@string/beneficiary_name_sample"
                    android:textColor="#26343B"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:id="@+id/issueBeneficiaryZone"
                    android:text="@string/beneficiary_zone_sample"
                    android:textColor="#526168"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:id="@+id/issueBeneficiaryDetails"
                    android:text="@string/beneficiary_details_sample"
                    android:textColor="#526168"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/issueBeneficiaryId"
                    android:text="@string/beneficiary_id_sample"
                    android:textColor="#26343B"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/qr_verified"
                    android:textColor="#397E69"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- REPORT ISSUE OUTER BORDER / CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="16dp">

            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:background="#7D898D"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/report_an_issue"
                android:textColor="#26343B"
                android:textSize="22sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/select_reason"
                android:textColor="#526168"
                android:textSize="14sp"/>

            <!-- ISSUE OPTIONS: RADIO INDICATORS ON THE RIGHT -->
            <RadioGroup
                android:id="@+id/issueReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/wrongPerson"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_field"
                    android:button="@null"
                    android:drawableEnd="@drawable/radio_right_selector"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/reason_wrong_person"
                    android:textColor="#26343B"
                    android:textSize="16sp"/>

                <RadioButton
                    android:id="@+id/addressChanged"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:button="@null"
                    android:drawableEnd="@drawable/radio_right_selector"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/reason_address_changed"
                    android:textColor="#26343B"
                    android:textSize="16sp"/>

                <RadioButton
                    android:id="@+id/noShow"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:button="@null"
                    android:drawableEnd="@drawable/radio_right_selector"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/reason_no_show"
                    android:textColor="#26343B"
                    android:textSize="16sp"/>
            </RadioGroup>

            <!-- ADDITIONAL DETAILS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/additional_details"
                android:textColor="#526168"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/issueDetails"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="@string/describe_what_happened"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#26343B"
                android:textColorHint="#7C898E"/>

            <!-- PRIMARY ACTION -->
            <Button
                android:id="@+id/submitIssue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/submit_issue"
                android:textAllCaps="false"
                android:textColor="#26343B"/>

            <!-- SECONDARY ACTION -->
            <Button
                android:id="@+id/cancelIssue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline_button"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="#26343B"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
