<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: print "Logging trace metric: ..." lines to Logcat
         (filter by FirebasePerformance) so traces can be checked while testing. -->
    <application>
        <meta-data
            android:name="firebase_performance_logcat_enabled"
            android:value="true" />
    </application>
</manifest>
