<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EDF2"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="18dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mukono Food Aid"
                android:textColor="#26343B"
                android:textSize="24sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLUNTEER"
                android:textColor="#64747C"
                android:textSize="12sp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="#AAB7BC"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Delivery verification" android:textColor="#3D4B52" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 of 12 stops" android:textColor="#3D4B52" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/scanArea"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_scanner"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="18dp" android:text="QR SCAN" android:textColor="#E7F4F3" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.14"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="16dp" android:text="● LIVE" android:textColor="#8BE4D0" android:textSize="11sp" android:background="#26383D" android:padding="8dp"/>
                <FrameLayout
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_frame">
                    <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="center" android:background="#74E8D0"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="+" android:textColor="#7FE4D0" android:textSize="26sp"/>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center" android:orientation="vertical" android:paddingBottom="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Align QR code within the frame" android:textColor="#FFFFFF" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Scanning automatically..." android:textColor="#A8B8BD" android:textSize="12sp"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ready to scan" android:textColor="#26343B" android:textSize="19sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Scan the QR code on the beneficiary card to open their profile." android:textColor="#4C5B62" android:textSize="14sp"/>
            <Button
                android:id="@+id/manualIdButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_field"
                android:text="Enter beneficiary ID"
                android:textAllCaps="false"
                android:textColor="#3E4C53"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap the scanner frame to preview a verified scan."
            android:textColor="#64747C"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
