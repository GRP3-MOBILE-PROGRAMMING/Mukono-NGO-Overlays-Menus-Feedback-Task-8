<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FB">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/splash_logo_bg">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="58sp"
                android:textStyle="bold"/>
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="MUKONO NGO"
            android:textColor="#183D43"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="FOOD AID • DELIVERY COORDINATION"
            android:textColor="#64747C"
            android:textSize="11sp"
            android:letterSpacing="0.10"/>
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="92dp"
            android:layout_height="3dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            android:indeterminateTint="#07838B"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:text="Serving communities with care"
        android:textColor="#87959A"
        android:textSize="12sp"/>
</FrameLayout>
