<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F7FB"
    android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mukono NGO • Warehouse coordinator" android:textColor="#526168" android:textSize="12sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TABLET VIEW • DELIVERY OPERATIONS" android:textColor="#526168" android:textSize="11sp"/>
    <View android:layout_width="180dp" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="#AAB7BC"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.25" android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAMPALA DELIVERY MAP" android:textColor="#183D43" android:textStyle="bold" android:textSize="15sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="12 stops • 4 zones • 3 volunteers active" android:textColor="#64747C" android:textSize="12sp"/>
            <ImageView
                android:id="@+id/deliveryMap"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:src="@drawable/kampala_map_reference"
                android:scaleType="fitXY"
                android:contentDescription="Kampala delivery map showing four colour-coded zones and twelve delivery stops"
                android:background="#E8E6DE"
                android:clickable="true"
                android:focusable="true"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Select a pin to view a delivery stop" android:textColor="#64747C" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/manifestPanel"
            android:layout_width="285dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delivery manifest" android:textColor="#26343B" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="TODAY • 17 NOVEMBER 2026" android:textColor="#64747C" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="TOTAL DELIVERIES" android:textColor="#64747C" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 scheduled • 8 completed" android:textColor="#26343B" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Filter by zone" android:textColor="#526168" android:textSize="12sp"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="38dp" android:text="All zones" android:textAllCaps="false" android:textSize="10sp"/>
                    <Button android:id="@+id/filterA" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Zone A" android:textAllCaps="false" android:textSize="10sp"/>
                    <Button android:id="@+id/filterB" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Zone B" android:textAllCaps="false" android:textSize="10sp"/>
                    <Button android:id="@+id/filterC" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Zone C" android:textAllCaps="false" android:textSize="10sp"/>
                    <Button android:id="@+id/filterD" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Zone D" android:textAllCaps="false" android:textSize="10sp"/>
                </LinearLayout>
            </HorizontalScrollView>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="#D6E0E3"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                <LinearLayout android:id="@+id/manifestList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/zoneAItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="08:30 • Zone A\nAmina N. – Kisenyi\nVolunteer: Sarah K.\nReassign volunteer  →" android:textColor="#34434A" android:textSize="12sp"/>
                    <TextView android:id="@+id/zoneBItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="10:00 • Zone B\nJohn O. – Katwe\nVolunteer: Peter M.\nReassign volunteer  →" android:textColor="#34434A" android:textSize="12sp"/>
                    <TextView android:id="@+id/zoneCItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="11:30 • Zone C\nGrace T. – Makindye\nVolunteer: Sarah K.\nReassign volunteer  →" android:textColor="#34434A" android:textSize="12sp"/>
                    <TextView android:id="@+id/zoneDItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="13:00 • Zone D\nMusa K. – Nakawa\nVolunteer: Brian O.\nReassign volunteer  →" android:textColor="#34434A" android:textSize="12sp"/>
                </LinearLayout>
            </ScrollView>
            <Button android:id="@+id/reassignButton" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_primary_button" android:text="Reassign selected delivery" android:textAllCaps="false" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
